load("//anybuild:serve.bzl", "build")
load(
    "//anybuild/tools:laravel.bzl",
    "laravel_config",
    "laravel_build",
    "laravel_serve",
)

config = laravel_config(
    schema = 1,
    php_framework = "laravel",
    php_version = "8.5",
    phpix = False,
    php_public_dir = "public",

    composer_enable = True,
    composer_build_script = "build:production",

    node_version = "24",
    node_package_manager = "npm",
    node_build_command = "npm run build",
)

laravel = laravel_build(config)

custom = build(
    steps = laravel.steps,
    serve_deps = [
        dep("shira/php", "8.5.10"),
        dep("bash"),
    ],
    mounts = laravel.mounts,
    env = laravel.env,
    app = laravel.app,
)

laravel_serve(
    config,
    custom,
    name = "itera",
)
